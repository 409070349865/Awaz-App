{
  "name": "awaz-backend",
  "version": "2.0.0",
  "description": "Awaz (آواز) — Production-ready Node.js backend for real-time voice translation",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "lint": "eslint \"server/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "mongoose": "^9.5.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "nodemon": "3.1.11"
  },
  "overrides": {
    "qs": "^6.17.1"
