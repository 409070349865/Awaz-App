# ══════════════════════════════════════════════════════════════════
#  AWAZ (آواز) — Environment Variables
#  Copy this file to  .env  and fill in your values.
#  Never commit  .env  to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production           # 'development' | 'production'
LOG_LEVEL=info                # 'debug' | 'info' | 'warn' | 'error'
MONGO_URI=mongodb://localhost:27017/awaz  # Optional unless Cloud history is enabled

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave blank (or set to '*') to allow all origins (dev only).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Replace local origins with your deployed frontend origin in production.

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_MAX=60             # Max requests per IP per minute (global)

# ── Request Timeout ───────────────────────────────────────────────
REQUEST_TIMEOUT_MS=7000       # 7 seconds

# Optional TURN relay for calls across restrictive networks. Configure coturn with
# use-auth-secret and the same shared secret; keep this secret out of frontend env files.
# TURN_SERVER_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-coturn-static-auth-secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# ══════════════════════════════════════════════════════════════════
#  CHOOSE ONE translation engine and fill in its credentials below.
#  Set TRANSLATE_ENGINE to one of:
#    freegoogle | libretranslate | google | deepl | openai
# ══════════════════════════════════════════════════════════════════
TRANSLATE_ENGINE=freegoogle
# Ordered provider fallbacks after the selected engine.
TRANSLATE_FALLBACKS=freegoogle,libretranslate

# ── LibreTranslate (FREE — recommended for getting started) ───────
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_APIKEY=               # Required by the public libretranslate.com endpoint

# ── Google Cloud Translation v2 ───────────────────────────────────
# https://console.cloud.google.com → APIs → Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=

# ── DeepL ─────────────────────────────────────────────────────────
# https://www.deepl.com/pro-api  (free tier: 500k chars/month)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com   # Use api.deepl.com for Pro

# ── OpenAI ────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini      # fast + cheap; use gpt-4o for highest quality
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
AI_REQUEST_TIMEOUT_MS=45000
AI_AUDIO_MAX_BYTES=20971520   # 20 MiB; audio is sent to the provider only when requested
